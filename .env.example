# Copia este archivo a .env y coloca tus valores reales.

# Clave de Google Gemini (capa gratuita: https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_api_key_aqui

# Modelo de Gemini a usar. Por defecto gemini-2.0-flash.
# Si se agota la cuota de 2.0-flash, prueba con: gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.0-flash

# Tipo de cambio USD -> PEN usado para homogeneizar precios de Amazon.com.
# Actualízalo cuando quieras reflejar el TC actual; no se consulta online.
TIPO_CAMBIO_USD_PEN=3.75
